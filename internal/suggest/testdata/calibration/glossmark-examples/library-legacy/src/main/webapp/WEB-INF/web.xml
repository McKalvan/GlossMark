<?xml version="1.0" encoding="UTF-8"?>
<!-- @gloss configures .CircWebApp scope=file conf=0.85 -->
<!-- Riverbend CIRC staff desk. Servlet 2.5: mappings live here, not in annotations. -->
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">
  <display-name>Riverbend Circulation</display-name>

  <listener>
    <listener-class>gov.riverbend.circ.servlet.CircContextListener</listener-class>
  </listener>

  <servlet>
    <servlet-name>checkout</servlet-name>
    <servlet-class>gov.riverbend.circ.servlet.CheckoutServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>checkin</servlet-name>
    <servlet-class>gov.riverbend.circ.servlet.CheckinServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>renew</servlet-name>
    <servlet-class>gov.riverbend.circ.servlet.RenewalServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>holds</servlet-name>
    <servlet-class>gov.riverbend.circ.servlet.HoldServlet</servlet-class>
  </servlet>
  <servlet>
    <servlet-name>finePayment</servlet-name>
    <servlet-class>gov.riverbend.circ.servlet.FinePaymentServlet</servlet-class>
  </servlet>

  <servlet-mapping><servlet-name>checkout</servlet-name><url-pattern>/circ/checkout</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>checkin</servlet-name><url-pattern>/circ/checkin</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>renew</servlet-name><url-pattern>/circ/renew</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>holds</servlet-name><url-pattern>/circ/holds</url-pattern></servlet-mapping>
  <servlet-mapping><servlet-name>finePayment</servlet-name><url-pattern>/circ/fines/pay</url-pattern></servlet-mapping>

  <resource-ref>
    <res-ref-name>jdbc/circ</res-ref-name>
    <res-type>javax.sql.DataSource</res-type>
    <res-auth>Container</res-auth>
  </resource-ref>

  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>
</web-app>
