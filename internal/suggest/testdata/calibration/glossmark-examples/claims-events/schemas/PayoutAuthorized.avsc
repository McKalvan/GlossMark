    {"name": "payoutId", "type": {"type": "string", "logicalType": "uuid"}},
    {"name": "amount", "type": "com.tidewater.claims.common.Money"},
    {"name": "payeeIbanLast4", "type": "string"},
    {"name": "expectedValueDate", "type": {"type": "int", "logicalType": "date"}}
  ]
}
