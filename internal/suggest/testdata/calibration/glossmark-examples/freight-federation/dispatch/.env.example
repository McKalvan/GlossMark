NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=postgresql://dispatch:dispatch@localhost:5432/dispatch?schema=public

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=dispatch
KAFKA_GROUP_ID=dispatch.shipment-booked

# Park Royal depot
DEPOT_LAT=51.5265
DEPOT_LNG=-0.2667
DEPOT_TIMEZONE=Europe/London

# Same-day ExpressPickup is accepted for shipments booked before this local time
EXPRESS_CUTOFF=11:00

AVG_SPEED_KMH=28
SERVICE_MINUTES=6
ETA_WINDOW_MINUTES=30
LINEHAUL_BUFFER_MINUTES=240
MIN_LEAD_MINUTES=20
