<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:skos="http://www.w3.org/2004/02/skos/core#"
         xmlns:obo="http://purl.obolibrary.org/obo/"
         xml:base="https://ref.example/lending">
  <owl:Class rdf:about="https://ref.example/lending#Patron">
    <rdfs:label xml:lang="fr">Usager</rdfs:label>
    <rdfs:label xml:lang="en">Patron</rdfs:label>
  </owl:Class>
  <owl:Class rdf:ID="Loan"><rdfs:label>Loan</rdfs:label></owl:Class>
  <owl:Class rdf:about="https://ref.example/lending#OverdueLoan">
    <rdfs:label>Overdue Loan</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://ref.example/lending#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://ref.example/lending#LoanItem">
    <rdfs:label>Loan Item</rdfs:label>
    <obo:BFO_0000050 rdf:resource="https://ref.example/lending#Loan"/>
  </owl:Class>
  <owl:Class rdf:about="https://ref.example/lending#LendingAgreement">
    <skos:prefLabel>Lending Agreement</skos:prefLabel>
    <rdfs:subClassOf rdf:resource="https://ref.example/lending#Loan"/>
    <rdfs:subClassOf>
      <owl:Restriction><owl:onProperty rdf:resource="https://ref.example/lending#covers"/></owl:Restriction>
    </rdfs:subClassOf>
  </owl:Class>
</rdf:RDF>
