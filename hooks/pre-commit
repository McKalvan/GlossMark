#!/usr/bin/env sh
# GlossMark pre-commit hook: lint markers and keep .glossmark/graph.jsonl current.
# Install: ln -s ../../hooks/pre-commit .git/hooks/pre-commit   (or use .pre-commit-hooks.yaml)
set -e
if ! command -v gloss >/dev/null 2>&1; then
  echo "gloss: not installed (curl -fsSL https://raw.githubusercontent.com/mckalvan/glossmark/main/install.sh | sh, or go install github.com/mckalvan/glossmark/cmd/gloss@v0.1.0)" >&2
  exit 0
fi
gloss check
gloss build -q
git add .glossmark/graph.jsonl .glossmark/context.jsonld .glossmark/ledger.jsonl 2>/dev/null || true
# Stale links do not block the commit; a CI that fails on them (drift-fail-on
# with stale) would, so say so now.
if ! gloss drift --fail-on stale >/dev/null 2>&1; then
  echo "gloss: some links are stale (gloss status lists them): check each still holds, then gloss accept --stale <paths>" >&2
fi
